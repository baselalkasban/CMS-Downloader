{
  "manifest_version": 3,
  "name": "GUC CMS Downloader",
  "version": "1.3.0",
  "description": "Renames GUC CMS downloads to their content title and sorts them into a folder per course.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://cms.guc.edu.eg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/*"
      ],
      "js": [
        "lib/naming.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/CourseViewStn.aspx*"
      ],
      "js": [
        "lib/ui.js",
        "filter.js",
        "course-view.js"
      ],
      "css": [
        "filter.css",
        "view.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/HomePageStn.aspx*"
      ],
      "js": [
        "lib/ui.js",
        "home-view.js"
      ],
      "css": [
        "view.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GUC CMS Downloader",
    "default_popup": "popup.html"
  }
}
