{
  "manifest_version": 3,
  "name": "GUC CMS Downloader",
  "version": "1.6.0",
  "description": "Pro redesign of the GUC CMS and Outlook: renamed downloads, themes, search, cleaner mail with local-AI summaries.",
  "permissions": [
    "downloads",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://cms.guc.edu.eg/*",
    "https://mail.guc.edu.eg/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/*"
      ],
      "js": [
        "lib/themes.js",
        "theme.js"
      ],
      "css": [
        "themes.css",
        "shell.css",
        "view.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/*"
      ],
      "js": [
        "lib/naming.js",
        "content.js",
        "lib/ui.js",
        "palette.js",
        "shell.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/CourseViewStn.aspx*"
      ],
      "js": [
        "filter.js",
        "course-view.js"
      ],
      "css": [
        "filter.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/HomePageStn.aspx*"
      ],
      "js": [
        "home-view.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.guc.edu.eg/owa/*"
      ],
      "js": [
        "lib/themes.js",
        "theme.js"
      ],
      "css": [
        "themes.css",
        "view.css",
        "mail.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mail.guc.edu.eg/owa/*"
      ],
      "js": [
        "lib/ui.js",
        "lib/mailtext.js",
        "mail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GUC CMS Downloader",
    "default_popup": "popup.html"
  }
}
